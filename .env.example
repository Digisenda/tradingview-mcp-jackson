# Neon Postgres — tradingview-sessions
# Copiar este archivo como .env y completar los valores reales
# Obtener DATABASE_URL en: https://console.neon.tech/app/projects/calm-moon-55605425/branches
DATABASE_URL=postgresql://neondb_owner:CHANGE_ME@ep-XXXX.c-2.us-east-1.aws.neon.tech/neondb?sslmode=require

# Claude API — requerida por el analizador de capturas Schwab (npm run schwab)
# Obtener en: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Email para notificaciones del vigía (watcher.js) — OPCIONAL
# Si no se configura, el vigía funciona igual pero sin enviar email.
# Requiere: npm install nodemailer
# NODEMAILER_HOST=smtp.gmail.com
# NODEMAILER_USER=tu@gmail.com
# NODEMAILER_PASS=tu_app_password   # App Password de Google (no la contraseña normal)
# NODEMAILER_TO=destino@gmail.com

